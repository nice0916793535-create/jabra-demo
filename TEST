    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Microsoft JhengHei", sans-serif; line-height: 1.6; color: #333; background-color: #f4f6f9; }
        
        /* Header & Banner */
        header { background: linear-gradient(135deg, #0052d4, #4364f7, #6fb1fc); color: white; padding: 2rem 1.5rem; text-align: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        header h1 { font-size: 2rem; margin-bottom: 0.3rem; }
        header p { font-size: 1.1rem; opacity: 0.9; }
        .subtitle { font-size: 0.9rem; background: rgba(255,255,255,0.2); display: inline-block; padding: 0.2rem 0.8rem; border-radius: 20px; margin-top: 0.5rem; }

        /* Search Bar */
        .search-container { max-width: 1000px; margin: 1.5rem auto 0; padding: 0 1rem; }
        .search-input { width: 100%; padding: 0.8rem 1.2rem; font-size: 1rem; border: 2px solid #e2e8f0; border-radius: 8px; outline: none; transition: border-color 0.2s; }
        .search-input:focus { border-color: #4364f7; }

        /* Main Grid Layout */
        .container { max-width: 1000px; margin: 1.5rem auto 3rem; padding: 0 1rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
        
        /* Cards */
        .card { background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.06); transition: transform 0.2s, box-shadow 0.2s; border-top: 4px solid #4364f7; }
        .card:hover { transform: translateY(-3px); box-shadow: 0 6px 16px rgba(0,0,0,0.1); }
        .card h2 { color: #1e293b; font-size: 1.25rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem; }
        
        /* Links & Tag List */
        .item-list { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
        .item-list li a { display: inline-block; background: #f1f5f9; color: #334155; text-decoration: none; padding: 0.4rem 0.8rem; border-radius: 6px; font-size: 0.95rem; font-weight: 500; transition: all 0.2s; }
        .item-list li a:hover { background: #4364f7; color: white; }
        
        /* Tag styles for Procurement code */
        .code-tag { font-size: 0.8rem; color: #64748b; background: #f8fafc; border: 1px solid #e2e8f0; padding: 0.2rem 0.5rem; border-radius: 4px; float: right; }

        footer { text-align: center; padding: 2rem; color: #64748b; font-size: 0.9rem; border-top: 1px solid #e2e8f0; background: white; }
    </style>
</head>
